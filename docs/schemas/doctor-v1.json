{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vex doctor v1",
  "type": "object",
  "required": ["schema_version", "success", "checks"],
  "properties": {
    "schema_version": { "const": 1 },
    "success": { "type": "boolean" },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["id", "status", "required", "message", "details"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ok", "warning", "error", "not_checked"] },
        "required": { "type": "boolean" },
        "message": { "type": "string" },
        "details": { "type": ["object", "null"] }
      }
    }
  }
}
